{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ghostapi/ui/*": ["./*"]
    }
  },
  "include": [
    "index.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "layouts/**/*.ts",
    "layouts/**/*.tsx",
    "blocks/**/*.ts",
    "blocks/**/*.tsx",
    "lib/**/*.ts",
    "hooks/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ]
}
