# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://ghostapi:ghostapi@localhost:5432/ghostapi

# Redis
REDIS_URL=redis://localhost:6379

# Frontend → backend (apps/web reads this)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# Auth — replace in non-dev environments. Must be at least 32 chars.
JWT_SECRET=change-me-change-me-change-me-change-me
