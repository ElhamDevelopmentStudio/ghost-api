{
  "name": "@ghostapi/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "build": "tsc --noEmit",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "node scripts/with-root-env.mjs prisma generate",
    "prisma:migrate": "node scripts/with-root-env.mjs prisma migrate dev",
    "prisma:studio": "node scripts/with-root-env.mjs prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@ghostapi/config": "workspace:*",
    "@ghostapi/mock-engine": "workspace:*",
    "@ghostapi/parser": "workspace:*",
    "@ghostapi/runtime": "workspace:*",
    "@ghostapi/types": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "0.19.10",
    "@hono/zod-validator": "^0.4.2",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.2.1",
    "@scalar/hono-api-reference": "0.10.14",
    "bcryptjs": "3.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "jose": "6.2.3",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "resend": "^6.12.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260517.1",
    "@ghostapi/eslint-config": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "eslint": "^9.18.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.86.0"
  }
}
