{
  "name": "@ghostapi/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@ghostapi/config": "workspace:*",
    "@ghostapi/mock-engine": "workspace:*",
    "@ghostapi/parser": "workspace:*",
    "@ghostapi/runtime": "workspace:*",
    "@ghostapi/types": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "0.19.10",
    "@hono/zod-validator": "^0.4.2",
    "@prisma/client": "^6.2.1",
    "@scalar/hono-api-reference": "0.10.14",
    "bcryptjs": "3.0.3",
    "hono": "^4.12.18",
    "jose": "6.2.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@ghostapi/eslint-config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
